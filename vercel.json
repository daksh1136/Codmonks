
{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        
        
        "includeFiles": ["dist/**"]
      }
    }
  ],
  "routes": [
    
    
    {
      "src": "/assets/(.*)",
      "dest": "/dist/client/assets/$1"
    },
    
    
    {
      "src": "/index.html",
      "dest": "/dist/client/index.html"
    },
    
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}